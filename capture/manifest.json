{
  "manifest_version": 3,
  "name": "PANAX capture",
  "version": "1.0.0",
  "description": "PANAX 모바일 화면의 블록을 클릭 한 번으로 같은 폭·같은 배율 PNG로 저장",
  "key": "",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://panaxgames.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PANAX capture"
  },
  "content_scripts": [
    {
      "matches": [
        "https://panaxgames.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://nerothecodeking.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
